[Unit]
Description=QuantumPACS daily database backup
After=network-online.target quantumpacs-backend.service
OnFailure=quantumpacs-failure-notify@%n.service

[Service]
Type=oneshot
# scripts/backup_db.sh discovers the container port/password by itself;
# override DATABASE_URL to back up a remote replica instead.
ExecStart=/home/quantumpacs/openpacs/scripts/backup_db.sh
Environment=BACKUP_DIR=/backups
Environment=RETENTION_DAYS=14

[Install]
WantedBy=timers.target
