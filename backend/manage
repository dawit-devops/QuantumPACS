#!/bin/bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$DIR/venv"

if [ -z "${1:-}" ]; then
    echo "Command needed (run, db)"
    exit 1
fi

DBNAME="quantumpacs"
DBUSER="quantumpacs"
DBHOST="${DBHOST:-localhost}"

postgres_psql() {
    sudo -u postgres psql -h "$DBHOST" -c "$1"
}

create_exts() {
    sudo -u postgres psql -h "$DBHOST" "$1" -c "CREATE EXTENSION IF NOT EXISTS intarray"
    sudo -u postgres psql -h "$DBHOST" "$1" -c "CREATE EXTENSION IF NOT EXISTS citext"
}

create_db() {
    postgres_psql "CREATE DATABASE $1"
    postgres_psql "GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO $DBUSER"
    postgres_psql "GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO $DBUSER"
    create_exts "$1"
}

drop_db() {
    postgres_psql "DROP DATABASE IF EXISTS $1"
}

handle_db() {
    if [ -z "${1:-}" ]; then
        echo "Command needed (create, init, import, start, stop, shell)"
        exit 1
    fi

    case $1 in
        init)
            DBPASS=$(openssl rand -base64 15)
            echo "db_pass: $DBPASS"
            postgres_psql "CREATE USER $DBUSER WITH PASSWORD '$DBPASS'"
            create_db "$DBNAME"
            ;;
        create)
            create_db "$DBNAME"
            ;;
        drop)
            drop_db "$DBNAME"
            ;;
        reset)
            drop_db "$DBNAME"
            create_db "$DBNAME"
            ;;
        migrate)
            $VENV/bin/alembic upgrade head
            ;;
        rollback)
            $VENV/bin/alembic downgrade -1
            ;;
        current)
            $VENV/bin/alembic current
            ;;
        history)
            $VENV/bin/alembic history
            ;;
        shell)
            psql -h "$DBHOST" "$DBNAME" -U "$DBUSER"
            ;;
        import)
            psql -h "$DBHOST" "$DBNAME" -U "$DBUSER" < dump.sql
            ;;
        *)
            echo "Usage: db {init|create|drop|reset|migrate|rollback|current|history|shell|import}"
            exit 1
            ;;
    esac
}

case $1 in
    run)
        $VENV/bin/python app.py
        ;;
    db)
        handle_db "${@:2}"
        ;;
    tenant)
        shift
        if [ "$1" = "migrate" ]; then
            shift
            $VENV/bin/python -m management.tenant_migrate "$@"
        elif [ "$1" = "migrate-one" ]; then
            shift
            $VENV/bin/python -m management.tenant_migrate "$1"
        else
            echo "Usage: tenant {migrate|migrate-one <slug>}"
            exit 1
        fi
        ;;
    *)
        echo "Unsupported command $1"
        exit 1
        ;;
esac
