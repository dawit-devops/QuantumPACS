# Copy to .env and adjust. docker compose reads this file for the
# ${VAR} substitutions in docker-compose.yaml. Never commit .env.

# PostgreSQL — applies on FIRST init of the postgres data volume only;
# changing it later requires `docker compose down -v` (destroys data).
POSTGRES_USER=quantumpacs
POSTGRES_PASSWORD=pa55w0rd
POSTGRES_DB=quantumpacs

# Backend secret — must not be a known default (assert_production_secret).
# Set a long random value in any non-dev deployment.
SECRET=quantumpacs-docker-compose-dev-secret-change-me
