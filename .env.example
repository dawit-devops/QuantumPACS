# Copy to .env and adjust. docker compose reads this file for the
# ${VAR} substitutions in docker-compose.yaml. Never commit .env.

# PostgreSQL — applies on FIRST init of the postgres data volume only;
# changing it later requires `docker compose down -v` (destroys data).
# The values here are dev defaults; docker-compose.prod.yaml refuses to
# start unless you override them (it has no defaults by design).
POSTGRES_USER=quantumpacs
POSTGRES_PASSWORD=pa55w0rd
POSTGRES_DB=quantumpacs

# Backend signing secret + superadmin bootstrap password. Both MUST be long
# random values; the backend refuses every known/committed default
# (assert_production_secret in config.py) and compose refuses to start
# without them. Generate e.g.:
#   openssl rand -hex 32
#   openssl rand -base64 24
SECRET=quantumpacs-docker-compose-dev-secret-change-me
SUPERADMIN_PASS=change-me-superadmin

# docker-compose.prod.yaml ONLY: required image tag for both app images —
# 'latest' is never allowed in production. Set e.g.:
#   IMAGE_TAG=$(git rev-parse --short HEAD)
# IMAGE_TAG=
