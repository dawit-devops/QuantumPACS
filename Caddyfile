:80 {
    root * /quantumpacs/frontend/dist
    try_files {path} /index.html

    header {
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws:; font-src 'self'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @api {
        path /api/*
    }
    reverse_proxy @api localhost:8080

    @ws {
        path /ws/*
    }
    reverse_proxy @ws localhost:8080

    file_server
}
