[Unit]
Description=QuantumPACS Backend (Starlette/Uvicorn)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/OPP/openpacs/backend
Environment=PATH=%h/Documents/OPP/openpacs/backend/venv/bin:/usr/bin:/bin
Environment=QUANTUMPACS_DOCKER=true
ExecStart=%h/Documents/OPP/openpacs/backend/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
